---
// src/pages/contact.astro
// Contact and Free Practice Revenue Assessment Page
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import LocationCard from '../components/forms/LocationCard.astro';
import Icon from '../components/common/Icon.astro';
---

<BaseLayout
  title="Contact Us & Request Free Revenue Assessment | Emberly Health"
  description="Contact Emberly Health in Plano, Texas. Request a free practice revenue assessment, speak with Daniela Reyes, or schedule a consultation for medical billing and coding."
>
  <!-- Hero Section -->
  <section class="py-12 sm:py-16 bg-white border-b border-emberly-light-gray">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emberly-orange-tint text-emberly-orange font-bold text-xs uppercase tracking-wider mb-4">
          <span>Get in Touch</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-emberly-charcoal font-heading tracking-tight leading-tight">
          Let’s Accelerate Your Practice Cash Flow
        </h1>
        <p class="mt-4 text-base sm:text-lg text-emberly-mid-gray leading-relaxed">
          Request a confidential revenue and denial assessment, or connect directly with our US client success leadership in Plano, Texas.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content: Form & Location Card -->
  <section class="py-14 sm:py-20 bg-emberly-warm-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left: Assessment Request Form -->
        <div class="lg:col-span-7">
          <ContactForm />
        </div>

        <!-- Right: Location & Direct Contact Card -->
        <div class="lg:col-span-5 space-y-6">
          <LocationCard />

          <!-- What Happens Next Guarantee Card -->
          <div class="bg-white border border-emberly-light-gray rounded-3xl p-6 sm:p-8 shadow-card">
            <h4 class="text-xs font-bold uppercase tracking-wider text-emberly-orange mb-3 flex items-center gap-1.5">
              <Icon name="clock" class="w-4 h-4" />
              Our 24-Hour Response Commitment
            </h4>
            <div class="space-y-3 text-xs text-emberly-charcoal">
              <p class="leading-relaxed">
                When you submit an assessment inquiry, we don't route you through a generic automated sales queue.
              </p>
              <ul class="space-y-2 text-emberly-mid-gray">
                <li class="flex items-start gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-emberly-orange mt-1.5 flex-shrink-0"></span>
                  <span>Daniela Reyes or a practice director responds within 1 business day.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-emberly-orange mt-1.5 flex-shrink-0"></span>
                  <span>We conduct a brief 15-minute phone alignment regarding your specialty EHR.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-emberly-orange mt-1.5 flex-shrink-0"></span>
                  <span>We prepare a written diagnostic projection highlighting recoverable revenue.</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
