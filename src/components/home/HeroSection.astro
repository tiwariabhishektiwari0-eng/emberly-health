---
// src/components/home/HeroSection.astro
import Icon from '../common/Icon.astro';
---

<section class="relative pt-8 sm:pt-14 pb-16 sm:pb-24 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Left Hero Text Content -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emberly-orange-tint border border-emberly-orange/20 text-emberly-charcoal text-xs font-semibold mb-6">
          <span class="w-2 h-2 rounded-full bg-emberly-orange animate-pulse"></span>
          <span>US-Based Medical Billing, Coding & Full RCM Partner</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-emberly-charcoal tracking-tight leading-[1.1] mb-6">
          Turn Claims Into Cash Faster <span class="text-emberly-orange">With Fewer Denials</span>
        </h1>

        <!-- Subheadline -->
        <p class="text-base sm:text-lg text-emberly-mid-gray max-w-xl leading-relaxed mb-8">
          Emberly Health eliminates clinical coding backlogs, accelerates payer reimbursements, and recovers aged receivables for US medical practices and specialized clinics through certified coder precision.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto">
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-emberly-orange text-white font-bold text-sm sm:text-base hover:bg-emberly-orange-hover shadow-card subtle-lift transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-emberly-orange focus-visible:ring-offset-2"
          >
            <span>Book a free assessment</span>
            <Icon name="arrow-right" class="w-4 h-4" />
          </a>
          <a
            href="/services"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-white border border-emberly-light-gray text-emberly-charcoal font-semibold text-sm sm:text-base hover:bg-emberly-warm-white hover:border-emberly-charcoal/30 subtle-lift transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-emberly-charcoal"
          >
            <span>Explore services</span>
          </a>
        </div>

        <!-- Quick Assurance Badges -->
        <div class="mt-10 pt-6 border-t border-emberly-light-gray/80 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-emberly-mid-gray font-medium">
          <div class="flex items-center gap-1.5">
            <Icon name="shield-check" class="w-4 h-4 text-emberly-orange" />
            <span>HIPAA-aware protocols</span>
          </div>
          <div class="flex items-center gap-1.5">
            <Icon name="award" class="w-4 h-4 text-emberly-orange" />
            <span>AAPC & AHIMA certified coders</span>
          </div>
          <div class="flex items-center gap-1.5">
            <Icon name="clock" class="w-4 h-4 text-emberly-orange" />
            <span>US Central Time client support</span>
          </div>
        </div>
      </div>

      <!-- Right Side: Bespoke Inline SVG Illustration (Claim Journey Looped Cycle) -->
      <div class="lg:col-span-5 relative flex items-center justify-center">
        <div class="relative w-full max-w-md lg:max-w-none bg-white border border-emberly-light-gray rounded-3xl p-6 sm:p-8 shadow-card">
          <!-- Ambient decorative card elements -->
          <div class="absolute -top-3 -right-3 bg-emberly-orange-tint border border-emberly-orange/30 text-emberly-orange font-bold text-[11px] px-3 py-1 rounded-full shadow-sm flex items-center gap-1.5">
            <Icon name="sparkles" class="w-3.5 h-3.5" />
            <span>Continuous Cycle</span>
          </div>

          <!-- Original Looped Claim Cycle SVG -->
          <svg viewBox="0 0 400 360" class="w-full h-auto select-none" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Diagram depicting a medical claim moving continuously through verification, coding, submission, and payment posting">
            <!-- Center Hub Circle -->
            <circle cx="200" cy="180" r="48" fill="#FAF7F4" stroke="#E5E7EB" stroke-width="2" />
            <!-- Inner Emberly Mark -->
            <g transform="translate(160, 140) scale(0.57)">
              <path d="M103.2 177 A54 54 0 1 1 200.7 168.5" fill="none" stroke="#F26B1D" stroke-width="9" stroke-linecap="round"/>
              <polygon points="211,172.3 190.4,164.7 196.6,179.8" fill="#F26B1D" stroke="#F26B1D" stroke-width="2"/>
              <rect x="139" y="118" width="22" height="64" rx="5" fill="#3F4650"/>
              <rect x="118" y="139" width="64" height="22" rx="5" fill="#3F4650"/>
            </g>

            <!-- Looped Orbital Track -->
            <path
              d="M 200 45 A 135 135 0 0 1 335 180 A 135 135 0 0 1 200 315 A 135 135 0 0 1 65 180 A 135 135 0 0 1 200 45"
              stroke="#E5E7EB"
              stroke-width="3"
              stroke-dasharray="6 6"
            />

            <!-- Orbital Directional Flow Arrow -->
            <path
              d="M 200 45 A 135 135 0 0 1 335 180"
              stroke="#F26B1D"
              stroke-width="3"
              stroke-linecap="round"
            />
            <polygon points="335,188 342,175 328,175" fill="#F26B1D" />

            <!-- Node 1: Pre-Auth & Intake (Top) -->
            <g transform="translate(200, 45)">
              <circle cx="0" cy="0" r="24" fill="#FFFFFF" stroke="#F26B1D" stroke-width="2.5" />
              <rect x="-8" y="-8" width="16" height="16" rx="2" fill="#FFF1E8" />
              <path d="M-4 0 L-1 3 L5 -3" stroke="#F26B1D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              <text x="0" y="-32" text-anchor="middle" font-size="11" font-weight="700" fill="#3F4650" font-family="Inter">1. Pre-Auth</text>
            </g>

            <!-- Node 2: Certified Coding (Right) -->
            <g transform="translate(335, 180)">
              <circle cx="0" cy="0" r="24" fill="#FFFFFF" stroke="#3F4650" stroke-width="2.5" />
              <rect x="-8" y="-8" width="16" height="16" rx="2" fill="#FAF7F4" />
              <path d="M-4 -3 H4 M-4 1 H4 M-4 5 H1" stroke="#3F4650" stroke-width="1.8" stroke-linecap="round" />
              <text x="35" y="4" text-anchor="start" font-size="11" font-weight="700" fill="#3F4650" font-family="Inter">2. Coding</text>
            </g>

            <!-- Node 3: Clean Claim Scrub (Bottom) -->
            <g transform="translate(200, 315)">
              <circle cx="0" cy="0" r="24" fill="#FFFFFF" stroke="#F26B1D" stroke-width="2.5" />
              <rect x="-8" y="-8" width="16" height="16" rx="2" fill="#FFF1E8" />
              <path d="M-4 -2 L4 2 M-4 2 L4 -2" stroke="#F26B1D" stroke-width="0" />
              <circle cx="0" cy="0" r="5" fill="#F26B1D" />
              <text x="0" y="38" text-anchor="middle" font-size="11" font-weight="700" fill="#3F4650" font-family="Inter">3. Scrubbing</text>
            </g>

            <!-- Node 4: Cash Capture & ERA (Left) -->
            <g transform="translate(65, 180)">
              <circle cx="0" cy="0" r="24" fill="#FFFFFF" stroke="#3F4650" stroke-width="2.5" />
              <circle cx="0" cy="0" r="10" fill="#3F4650" />
              <path d="M0 -5 V5 M-3 -2 H2 A1.5 1.5 0 0 1 2 1 H-2 A1.5 1.5 0 0 0 -2 4 H3" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" />
              <text x="-35" y="4" text-anchor="end" font-size="11" font-weight="700" fill="#3F4650" font-family="Inter">4. Paid</text>
            </g>

            <!-- Floating Micro Metric Tag -->
            <rect x="135" y="240" width="130" height="28" rx="14" fill="#3F4650" />
            <text x="200" y="258" text-anchor="middle" font-size="11" font-weight="600" fill="#FFFFFF" font-family="Inter">98.4% Clean Claims*</text>
          </svg>

          <!-- Diagram Subtitle -->
          <div class="mt-4 pt-3 border-t border-emberly-light-gray flex items-center justify-between text-xs text-emberly-mid-gray">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Automated Clearinghouse Sync
            </span>
            <span class="font-medium text-emberly-charcoal">Zero Payer Lag</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
