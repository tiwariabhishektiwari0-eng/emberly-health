---
// src/components/home/RevenueJourney.astro
// Interactive 7-step horizontal timeline for the Revenue Cycle Journey
import Icon from '../common/Icon.astro';

const journeySteps = [
  {
    step: 1,
    id: 'step-eligibility',
    title: 'Eligibility & Prior Auth',
    tag: 'Pre-Encounter Gate',
    shortDesc: 'Verification of coverage limits, deductibles, and prior authorizations 48 hours before treatment.',
    deliverables: [
      'Comprehensive 48-hour pre-visit benefit verification',
      'Electronic prior authorization submissions & peer prep',
      'Accurate patient copay and deductible calculation'
    ],
    bottlenecksAvoided: 'Prevents eligibility-based denials (CO-27, CO-29) which account for over 22% of rejected claims.'
  },
  {
    step: 2,
    id: 'step-charge-capture',
    title: 'Charge Capture',
    tag: 'Clinical Audit',
    shortDesc: 'Reconciling scheduled appointments against encounter forms and EHR notes to eliminate unbilled services.',
    deliverables: [
      'Daily encounter cross-referencing against appointment logs',
      'Missed billable procedure detection within 24 hours',
      'Customized fee schedule auditing across payer tiers'
    ],
    bottlenecksAvoided: 'Eliminates revenue leakage from uncaptured bedside procedures and delayed encounter reconciliation.'
  },
  {
    step: 3,
    id: 'step-medical-coding',
    title: 'Medical Coding',
    tag: 'AAPC / AHIMA QA',
    shortDesc: 'Certified coders assign accurate CPT, ICD-10-CM, and HCPCS Level II codes with appropriate modifiers.',
    deliverables: [
      'Dual-layer certified coder review for complex specialties',
      'Appropriate modifier assignment (e.g., -25, -59, -X{EPSU})',
      'Annual NCCI edit compliance and code update auditing'
    ],
    bottlenecksAvoided: 'Stops modifier mismatch rejections, medical necessity denials, and costly downcoding revenue loss.'
  },
  {
    step: 4,
    id: 'step-claim-submission',
    title: 'Claim Submission',
    tag: 'Clearinghouse Scrub',
    shortDesc: 'Daily batch scrubbing through advanced electronic clearinghouse rules to catch errors prior to payer receipt.',
    deliverables: [
      'Rule-based scrubbing for payer-specific formatting quirks',
      'Same-day electronic clearinghouse transmission (837P / 837I)',
      'Immediate front-end clearinghouse rejection remediation'
    ],
    bottlenecksAvoided: 'Guarantees claims bypass clearinghouse rejections without touching the 30/60/90-day payer clock.'
  },
  {
    step: 5,
    id: 'step-payment-posting',
    title: 'Payment Posting',
    tag: 'Ledger Reconciliation',
    shortDesc: 'Daily posting of Electronic Remittance Advice (835 ERA) and paper EOBs with contractual write-off audits.',
    deliverables: [
      'Auto-matching ERAs with bank deposit confirmations',
      'Audit of allowed amounts against negotiated payer contracts',
      'Line-item secondary payer and patient responsibility splitting'
    ],
    bottlenecksAvoided: 'Prevents untracked underpayments, unauthorized write-offs, and phantom balance ledger discrepancies.'
  },
  {
    step: 6,
    id: 'step-denial-management',
    title: 'Denials & A/R Follow-up',
    tag: 'Root-Cause Appeals',
    shortDesc: 'Systematic analysis of Claim Adjustment Reason Codes (CARC) with aggressive appeal submission within 48 hours.',
    deliverables: [
      'Rapid root-cause triage by CARC and RARC remittance codes',
      'Exhaustive Level 1, 2, and external review appeal drafting',
      'Payer representative phone escalations for aged >60 day claims'
    ],
    bottlenecksAvoided: 'Recovers revenue that practices routinely write off due to lack of staff follow-up bandwidth.'
  },
  {
    step: 7,
    id: 'step-patient-billing',
    title: 'Patient Billing',
    tag: 'Respectful Collections',
    shortDesc: 'Transparent, easy-to-understand digital and mailed statements with courteous patient payment inquiry support.',
    deliverables: [
      'Clean, jargon-free statements post-insurance adjudication',
      'Online payment portal integration with self-serve plans',
      'Dedicated US telephone support for patient billing questions'
    ],
    bottlenecksAvoided: 'Reduces bad-debt write-offs while maintaining patient trust and clinical satisfaction.'
  }
];
---

<section class="py-16 sm:py-24 bg-emberly-warm-white" id="revenue-journey-section">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emberly-orange-tint text-emberly-orange font-bold text-xs uppercase tracking-wider mb-3">
        <span>Transparent Operational Workflow</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-emberly-charcoal font-heading tracking-tight">
        The Revenue Cycle Journey
      </h2>
      <p class="mt-3 text-sm sm:text-base text-emberly-mid-gray">
        Explore how claims move seamlessly from patient scheduling to deposited cash. Click any step to inspect deliverables, quality controls, and avoided bottlenecks.
      </p>
    </div>

    <!-- 7-Step Horizontal Timeline Bar (Scrollable on small screens) -->
    <div class="relative mb-8 pb-4 overflow-x-auto no-scrollbar" role="tablist" aria-label="Revenue Cycle Steps">
      <div class="min-w-[760px] flex items-center justify-between relative px-4">
        <!-- Connecting Track Line -->
        <div class="absolute top-5 left-10 right-10 h-1 bg-emberly-light-gray -z-0" aria-hidden="true">
          <div id="timeline-progress-bar" class="h-full bg-emberly-orange transition-all duration-300 w-[14%]"></div>
        </div>

        {journeySteps.map((step, idx) => (
          <button
            type="button"
            role="tab"
            id={`tab-${step.step}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-controls={`panel-${step.step}`}
            tabindex={idx === 0 ? 0 : -1}
            data-step={step.step}
            class={`journey-step-btn relative z-10 flex flex-col items-center group focus:outline-none focus-visible:ring-2 focus-visible:ring-emberly-orange rounded-xl p-2 ${
              idx === 0 ? 'active-step' : ''
            }`}
          >
            <!-- Step Number Node Circle -->
            <div class={`step-node w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm transition-all duration-200 ${
              idx === 0
                ? 'bg-emberly-orange text-white shadow-md ring-4 ring-emberly-orange-tint'
                : 'bg-white border-2 border-emberly-light-gray text-emberly-charcoal group-hover:border-emberly-orange group-hover:text-emberly-orange'
            }`}>
              {step.step}
            </div>
            <!-- Step Title Label -->
            <span class={`step-label mt-2.5 text-xs font-bold text-center max-w-[95px] leading-tight transition-colors ${
              idx === 0 ? 'text-emberly-orange' : 'text-emberly-charcoal group-hover:text-emberly-orange'
            }`}>
              {step.title}
            </span>
          </button>
        ))}
      </div>
    </div>

    <!-- Active Step Detail Drawer / Panels -->
    <div class="relative bg-white border border-emberly-light-gray rounded-3xl p-6 sm:p-10 shadow-card">
      {journeySteps.map((step, idx) => (
        <div
          id={`panel-${step.step}`}
          role="tabpanel"
          aria-labelledby={`tab-${step.step}`}
          class={`journey-panel transition-opacity duration-300 ${idx === 0 ? 'block' : 'hidden'}`}
        >
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <!-- Left Info -->
            <div class="lg:col-span-7">
              <div class="flex items-center gap-2 mb-3">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emberly-orange-tint text-emberly-orange">
                  Step 0{step.step} of 07
                </span>
                <span class="text-xs font-semibold text-emberly-mid-gray uppercase tracking-wider">
                  {step.tag}
                </span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-extrabold text-emberly-charcoal mb-4 font-heading">
                {step.title}
              </h3>
              <p class="text-sm sm:text-base text-emberly-charcoal/90 leading-relaxed mb-6">
                {step.shortDesc}
              </p>

              <!-- Deliverables Checklist -->
              <h4 class="text-xs font-bold uppercase tracking-wider text-emberly-charcoal mb-3 flex items-center gap-1.5">
                <Icon name="check-circle" class="w-4 h-4 text-emberly-orange" />
                Emberly Quality Controls & Deliverables
              </h4>
              <ul class="space-y-2.5">
                {step.deliverables.map((item) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-emberly-charcoal">
                    <span class="w-1.5 h-1.5 rounded-full bg-emberly-orange mt-2 flex-shrink-0"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Right Bottlenecks Prevented Box -->
            <div class="lg:col-span-5 flex flex-col justify-between bg-emberly-warm-white rounded-2xl p-6 border border-emberly-light-gray h-full">
              <div>
                <div class="flex items-center gap-2 text-emberly-orange font-bold text-xs uppercase tracking-wider mb-2">
                  <Icon name="shield-check" class="w-4 h-4" />
                  <span>Bottlenecks Prevented</span>
                </div>
                <h4 class="text-base font-bold text-emberly-charcoal mb-2">
                  Why this step is critical
                </h4>
                <p class="text-xs sm:text-sm text-emberly-mid-gray leading-relaxed mb-6">
                  {step.bottlenecksAvoided}
                </p>
              </div>

              <div class="pt-4 border-t border-emberly-light-gray/80 flex items-center justify-between">
                <a
                  href="/contact"
                  class="text-xs font-bold text-emberly-orange hover:text-emberly-orange-hover inline-flex items-center gap-1"
                >
                  Audit your practice at Step {step.step}
                  <Icon name="arrow-right" class="w-3.5 h-3.5" />
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Vanilla interactive tabs for the 7-step timeline
  const stepButtons = document.querySelectorAll<HTMLButtonElement>('.journey-step-btn');
  const panels = document.querySelectorAll<HTMLElement>('.journey-panel');
  const progressBar = document.getElementById('timeline-progress-bar');

  const totalSteps = stepButtons.length;

  stepButtons.forEach((btn, index) => {
    btn.addEventListener('click', () => {
      setActiveStep(index);
    });

    btn.addEventListener('keydown', (e) => {
      let targetIndex = -1;
      if (e.key === 'ArrowRight') {
        targetIndex = (index + 1) % totalSteps;
      } else if (e.key === 'ArrowLeft') {
        targetIndex = (index - 1 + totalSteps) % totalSteps;
      }

      if (targetIndex !== -1) {
        stepButtons[targetIndex].focus();
        setActiveStep(targetIndex);
      }
    });
  });

  function setActiveStep(activeIndex: number) {
    stepButtons.forEach((btn, idx) => {
      const isSelected = idx === activeIndex;
      btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
      btn.setAttribute('tabindex', isSelected ? '0' : '-1');

      const node = btn.querySelector('.step-node');
      const label = btn.querySelector('.step-label');

      if (isSelected) {
        node?.classList.remove('bg-white', 'border-2', 'border-emberly-light-gray', 'text-emberly-charcoal');
        node?.classList.add('bg-emberly-orange', 'text-white', 'shadow-md', 'ring-4', 'ring-emberly-orange-tint');
        label?.classList.remove('text-emberly-charcoal');
        label?.classList.add('text-emberly-orange');
      } else {
        node?.classList.remove('bg-emberly-orange', 'text-white', 'shadow-md', 'ring-4', 'ring-emberly-orange-tint');
        node?.classList.add('bg-white', 'border-2', 'border-emberly-light-gray', 'text-emberly-charcoal');
        label?.classList.remove('text-emberly-orange');
        label?.classList.add('text-emberly-charcoal');
      }
    });

    panels.forEach((panel, idx) => {
      if (idx === activeIndex) {
        panel.classList.remove('hidden');
        panel.classList.add('block');
      } else {
        panel.classList.add('hidden');
        panel.classList.remove('block');
      }
    });

    // Update progress bar width
    if (progressBar) {
      const percentage = ((activeIndex) / (totalSteps - 1)) * 100;
      progressBar.style.width = `${Math.max(14, percentage)}%`;
    }
  }
</script>
