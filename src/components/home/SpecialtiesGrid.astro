---
// src/components/home/SpecialtiesGrid.astro
// Chip grid showcasing clinical expertise across 9 medical specialties
import Icon from '../common/Icon.astro';

const specialties = [
  { name: 'Primary Care', slug: 'primary-care', desc: 'Chronic care management (CCM), annual wellness visits, and preventive code audits.' },
  { name: 'Cardiology', slug: 'cardiology', desc: 'Complex catheterization, echocardiography, nuclear imaging, and modifier -25 accuracy.' },
  { name: 'Orthopedics', slug: 'orthopedics', desc: 'Surgical global periods, fracture care casting, intra-articular injections, and durable medical equipment.' },
  { name: 'Dermatology', slug: 'dermatology', desc: 'Biopsy lesion excision coding, Mohs micrographic surgery, and pathology bundling defense.' },
  { name: 'Behavioral Health', slug: 'behavioral-health', desc: 'Time-based psychotherapy units, crisis encounters, and telehealth parity billing compliance.' },
  { name: 'Urgent Care', slug: 'urgent-care', desc: 'Walk-in high-velocity claims, rapid commercial payer verification, and episodic billing.' },
  { name: 'Radiology', slug: 'radiology', desc: 'Professional vs. technical component splitting (modifiers -26 & -TC) and high-volume batch coding.' },
  { name: 'Physical Therapy', slug: 'physical-therapy', desc: '8-minute rule timed units, therapy cap tracking, KX modifier compliance, and progress note audits.' },
  { name: 'Multi-Specialty Groups', slug: 'multi-specialty-groups', desc: 'Consolidated master fee schedules, cross-specialty credentialing, and multi-provider reconciliation.' },
];
---

<section class="py-16 sm:py-24 bg-white border-t border-emberly-light-gray" id="specialties-section">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div class="max-w-2xl">
        <span class="text-xs uppercase font-bold tracking-wider text-emberly-orange">Clinical Breadth</span>
        <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold text-emberly-charcoal font-heading tracking-tight">
          Specialty-Specific Billing & Coding Nuance
        </h2>
        <p class="mt-3 text-sm sm:text-base text-emberly-mid-gray">
          Generic billing approaches result in missed clinical revenue. Our coding pods master the specific modifiers, global surgery periods, and payer policies of your medical discipline.
        </p>
      </div>
      <div class="mt-6 md:mt-0 flex-shrink-0">
        <a href="/specialties" class="inline-flex items-center gap-1.5 text-sm font-bold text-emberly-orange hover:text-emberly-orange-hover">
          <span>Explore specialty guides</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </div>
    </div>

    <!-- 9 Specialties Chip Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {specialties.map((item) => (
        <a
          href="/specialties"
          class="group flex flex-col justify-between p-6 rounded-2xl bg-emberly-warm-white/60 border border-emberly-light-gray hover:bg-white hover:border-emberly-orange/50 hover:shadow-subtle subtle-lift transition-all"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-base font-bold text-emberly-charcoal group-hover:text-emberly-orange transition-colors font-heading">
                {item.name}
              </h3>
              <div class="w-7 h-7 rounded-full bg-emberly-orange-tint flex items-center justify-center text-emberly-orange group-hover:bg-emberly-orange group-hover:text-white transition-colors">
                <Icon name="chevron-right" class="w-4 h-4" />
              </div>
            </div>
            <p class="text-xs text-emberly-mid-gray leading-relaxed">
              {item.desc}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-emberly-light-gray/60 flex items-center justify-between text-[11px] text-emberly-mid-gray">
            <span class="text-emberly-charcoal font-semibold">Specialized pod</span>
            <span class="group-hover:text-emberly-orange transition-colors">View clinical specs &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
