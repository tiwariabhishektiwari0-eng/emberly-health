---
// src/components/common/Footer.astro
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const services = [
  { title: 'Medical Billing', href: '/services/medical-billing' },
  { title: 'Medical Coding', href: '/services/medical-coding' },
  { title: 'End-to-End RCM', href: '/services/end-to-end-rcm' },
  { title: 'Denial Management', href: '/services/denial-management-and-appeals' },
  { title: 'A/R Follow-up', href: '/services/ar-follow-up' },
  { title: 'Eligibility & Prior Auth', href: '/services/eligibility-verification-prior-auth' },
  { title: 'Provider Credentialing', href: '/services/provider-credentialing' },
  { title: 'Patient Billing & Posting', href: '/services/patient-billing-payment-posting' },
];

const companyLinks = [
  { title: 'About Us', href: '/about' },
  { title: 'Specialties', href: '/specialties' },
  { title: 'Knowledge Base', href: '/resources' },
  { title: 'Careers', href: '/careers' },
  { title: 'Contact & Location', href: '/contact' },
];

const legalLinks = [
  { title: 'Privacy Policy', href: '/privacy-policy' },
  { title: 'Terms of Use', href: '/terms-of-use' },
  { title: 'HIPAA & PHI Notice', href: '/hipaa-notice' },
];
---

<footer class="bg-emberly-dark-charcoal text-white pt-16 pb-12 border-t border-emberly-charcoal/30">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-white/10">
      <!-- Col 1 & 2: Brand & Contact -->
      <div class="lg:col-span-2 flex flex-col justify-between">
        <div>
          <Logo variant="dark" size="md" showTagline={true} />
          <p class="mt-4 text-sm text-emberly-light-gray/80 max-w-sm leading-relaxed">
            US-based healthcare revenue cycle management partner. Accelerating cash flow, reducing preventable denials, and providing transparent financial reporting for independent practices and clinical groups.
          </p>

          <div class="mt-6 flex flex-col gap-2.5 text-xs text-emberly-light-gray/80">
            <div class="flex items-start gap-2.5">
              <Icon name="map-pin" class="w-4 h-4 text-emberly-orange flex-shrink-0 mt-0.5" />
              <span>2400 Meridian Park Drive, Suite 310, Plano, TX 75024</span>
            </div>
            <div class="flex items-center gap-2.5">
              <Icon name="phone" class="w-4 h-4 text-emberly-orange flex-shrink-0" />
              <a href="tel:2145550147" class="hover:text-emberly-orange transition-colors">(214) 555-0147</a>
            </div>
            <div class="flex items-center gap-2.5">
              <Icon name="mail" class="w-4 h-4 text-emberly-orange flex-shrink-0" />
              <a href="mailto:hello@emberlyhealth.com" class="hover:text-emberly-orange transition-colors">hello@emberlyhealth.com</a>
            </div>
            <div class="flex items-center gap-2.5">
              <Icon name="clock" class="w-4 h-4 text-emberly-orange flex-shrink-0" />
              <span>Mon&ndash;Fri: 8:00 AM &ndash; 6:00 PM CT</span>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-white/5">
          <p class="text-xs text-emberly-light-gray/60 font-medium">
            Primary Client Contact: Daniela Reyes, Director of Client Success
          </p>
        </div>
      </div>

      <!-- Col 3: Services -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-emberly-orange mb-4">Services</h4>
        <ul class="space-y-2.5 text-sm">
          {services.map((item) => (
            <li>
              <a href={item.href} class="text-emberly-light-gray/80 hover:text-emberly-orange transition-colors text-xs sm:text-sm">
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Practice & Resources -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-emberly-orange mb-4">Company</h4>
        <ul class="space-y-2.5 text-sm">
          {companyLinks.map((item) => (
            <li>
              <a href={item.href} class="text-emberly-light-gray/80 hover:text-emberly-orange transition-colors text-xs sm:text-sm">
                {item.title}
              </a>
            </li>
          ))}
        </ul>

        <h4 class="text-xs font-bold uppercase tracking-wider text-emberly-orange mt-6 mb-3">Governance</h4>
        <ul class="space-y-2 text-sm">
          {legalLinks.map((item) => (
            <li>
              <a href={item.href} class="text-emberly-light-gray/70 hover:text-emberly-orange transition-colors text-xs">
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 5: Assessment CTA Box -->
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5 flex flex-col justify-between">
        <div>
          <div class="w-8 h-8 rounded-lg bg-emberly-orange/20 text-emberly-orange flex items-center justify-center mb-3">
            <Icon name="sparkles" class="w-4 h-4" />
          </div>
          <h4 class="text-sm font-bold text-white mb-1.5">Free Practice Revenue Audit</h4>
          <p class="text-xs text-emberly-light-gray/80 leading-relaxed mb-4">
            Discover hidden denial patterns and quantify potential cash recovery with a zero-obligation review.
          </p>
        </div>
        <a
          href="/contact"
          class="w-full py-2.5 px-3 bg-emberly-orange text-white text-xs font-bold rounded-xl hover:bg-emberly-orange-hover text-center transition-colors shadow-sm block"
        >
          Request Assessment
        </a>
      </div>
    </div>

    <!-- Bottom Disclaimer & Copyright -->
    <div class="pt-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-xs text-emberly-light-gray/60">
      <div class="max-w-3xl leading-relaxed">
        <p>
          <strong>Notice:</strong> Emberly Health provides administrative billing, coding, and operational revenue cycle services under HIPAA-aware protocols. Any figures, benchmarks, or metrics referenced on this website represent sample operational estimates and historical averages; actual results vary based on clinical specialty, payer mix, and historical denial volume. We execute formal Business Associate Agreements (BAAs) with all medical practice partners before handling protected health information.
        </p>
      </div>
      <div class="flex-shrink-0 text-left md:text-right">
        <p>&copy; {new Date().getFullYear()} Emberly Health. All rights reserved.</p>
        <p class="text-[11px] text-emberly-light-gray/40 mt-0.5">Plano, Texas, USA</p>
      </div>
    </div>
  </div>
</footer>
