---
// src/components/home/HowWeWork.astro
// 3-step engagement framework: Assess > Onboard > Optimize
import Icon from '../common/Icon.astro';

const steps = [
  {
    num: '01',
    title: 'Assess & Benchmark',
    tag: 'Days 1–5',
    desc: 'We perform a zero-risk historical billing and denial audit. Our senior specialists analyze your last 90–180 days of clearinghouse remittances to uncover uncollected revenue, payer-specific denial codes, and coding leakages.',
    outcome: 'Deliverable: Practice Revenue Diagnostic Report with quantified cash recovery projection.'
  },
  {
    num: '02',
    title: 'Onboard & Bridge',
    tag: 'Weeks 2–3',
    desc: 'We execute a mutual Business Associate Agreement (BAA), establish secure API or user credentials into your existing EHR/PM system, align provider master fee schedules, and configure specialized clearinghouse scrubbing rules.',
    outcome: 'Deliverable: Zero clinical workflow disruption; full EHR and payer bridge validation.'
  },
  {
    num: '03',
    title: 'Optimize & Accelerate',
    tag: 'Ongoing Cadence',
    desc: 'Our dedicated pod takes over daily charge capture scrubbing, certified coding review, same-day electronic submissions, and aggressive denial appeals. You receive weekly executive KPI reports and real-time dashboard visibility.',
    outcome: 'Deliverable: Consistent 98%+ clean claims, lower days in A/R, and faster cash deposits.'
  }
];
---

<section class="py-16 sm:py-24 bg-emberly-warm-white border-t border-emberly-light-gray">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs uppercase font-bold tracking-wider text-emberly-orange">Structured Partnership</span>
      <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold text-emberly-charcoal font-heading tracking-tight">
        How We Work: A Frictionless 3-Step Journey
      </h2>
      <p class="mt-3 text-sm sm:text-base text-emberly-mid-gray">
        No lengthy operational delays or clinical disruption. We integrate directly into your current practice management software.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      {steps.map((step) => (
        <div class="relative bg-white border border-emberly-light-gray rounded-2xl p-6 sm:p-8 flex flex-col justify-between shadow-subtle hover:border-emberly-orange/40 subtle-lift transition-all">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl font-extrabold text-emberly-orange/30 font-heading">
                {step.num}
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider text-emberly-charcoal px-2.5 py-0.5 rounded-full bg-emberly-warm-white border border-emberly-light-gray">
                {step.tag}
              </span>
            </div>

            <h3 class="text-xl font-bold text-emberly-charcoal mb-3 font-heading">
              {step.title}
            </h3>

            <p class="text-xs sm:text-sm text-emberly-mid-gray leading-relaxed mb-6">
              {step.desc}
            </p>
          </div>

          <div class="pt-4 border-t border-emberly-light-gray/70 bg-emberly-orange-tint/30 -mx-6 -mb-6 sm:-mx-8 sm:-mb-8 p-4 sm:p-5 rounded-b-2xl">
            <p class="text-xs font-semibold text-emberly-charcoal leading-snug">
              {step.outcome}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
