---
// src/components/home/DarkCtaBand.astro
// High-contrast dark charcoal conversion section
import Icon from '../common/Icon.astro';
---

<section class="py-16 sm:py-20 bg-emberly-dark-charcoal text-white relative overflow-hidden">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 relative z-10 text-center">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 text-emberly-orange text-xs font-bold uppercase tracking-wider mb-6 border border-white/15">
      <Icon name="sparkles" class="w-3.5 h-3.5" />
      <span>Zero Obligation &middot; Completely Confidential</span>
    </div>

    <!-- Title -->
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-heading tracking-tight max-w-3xl mx-auto leading-tight mb-6">
      Ready to Accelerate Cash Flow and Eliminate Preventable Denials?
    </h2>

    <!-- Subtitle -->
    <p class="text-sm sm:text-base text-emberly-light-gray/80 max-w-2xl mx-auto leading-relaxed mb-8">
      Request a free practice revenue assessment. Our certified specialists will review your recent remittance trends and pinpoint uncollected cash opportunities in your A/R within 48 hours.
    </p>

    <!-- Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-full bg-emberly-orange text-white font-bold text-sm sm:text-base hover:bg-emberly-orange-hover shadow-lg subtle-lift transition-all"
      >
        <span>Request your free assessment</span>
        <Icon name="arrow-right" class="w-4 h-4" />
      </a>
      <a
        href="tel:2145550147"
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold text-sm transition-all"
      >
        <Icon name="phone" class="w-4 h-4 text-emberly-orange" />
        <span>Direct: (214) 555-0147</span>
      </a>
    </div>

    <!-- Assurance tag -->
    <p class="mt-8 text-[11px] text-emberly-light-gray/60 max-w-md mx-auto">
      No long-term contracts required to assess your practice. All inquiries are covered by mutual confidentiality and HIPAA-aware safeguards.
    </p>
  </div>
</section>
