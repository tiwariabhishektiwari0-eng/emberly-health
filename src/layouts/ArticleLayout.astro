---
// src/layouts/ArticleLayout.astro
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/common/Icon.astro';

interface Props {
  title: string;
  description: string;
  publishDate: string;
  author: string;
  authorRole: string;
  readTime: string;
  category: string;
  tags: string[];
}

const { title, description, publishDate, author, authorRole, readTime, category, tags } = Astro.props;
---

<BaseLayout title={`${title} | Emberly Health Insights`} description={description} ogType="article">
  <article class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-emberly-mid-gray mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-emberly-orange">Home</a>
        <span>/</span>
        <a href="/resources" class="hover:text-emberly-orange">Resources</a>
        <span>/</span>
        <span class="text-emberly-charcoal font-medium truncate max-w-xs">{title}</span>
      </nav>

      <!-- Article Header -->
      <header class="mb-10 pb-8 border-b border-emberly-light-gray">
        <div class="flex items-center gap-2.5 mb-4">
          <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-emberly-orange-tint text-emberly-orange">
            {category}
          </span>
          <span class="text-xs text-emberly-mid-gray flex items-center gap-1">
            <Icon name="clock" class="w-3.5 h-3.5" />
            {readTime}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-emberly-charcoal font-heading tracking-tight leading-tight mb-4">
          {title}
        </h1>

        <p class="text-base sm:text-lg text-emberly-mid-gray leading-relaxed mb-6">
          {description}
        </p>

        <!-- Author Byline -->
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-emberly-orange-tint text-emberly-orange font-bold flex items-center justify-center text-sm border border-emberly-orange/20">
            {author.split(' ').map(n => n[0]).join('')}
          </div>
          <div>
            <div class="text-xs sm:text-sm font-bold text-emberly-charcoal">{author}</div>
            <div class="text-[11px] text-emberly-mid-gray">{authorRole} &middot; Published {publishDate}</div>
          </div>
        </div>
      </header>

      <!-- Markdown Content Body -->
      <div class="prose prose-slate max-w-none prose-headings:font-heading prose-headings:text-emberly-charcoal prose-p:text-emberly-charcoal/90 prose-p:leading-relaxed prose-li:text-emberly-charcoal/90 prose-strong:text-emberly-charcoal prose-a:text-emberly-orange prose-a:underline hover:prose-a:text-emberly-orange-hover">
        <slot />
      </div>

      <!-- Tags & Share Footer -->
      <footer class="mt-12 pt-8 border-t border-emberly-light-gray flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-semibold text-emberly-mid-gray">Tags:</span>
          {tags.map((tag) => (
            <span class="text-xs px-2.5 py-1 rounded-md bg-white border border-emberly-light-gray text-emberly-charcoal">
              #{tag}
            </span>
          ))}
        </div>

        <a
          href="/resources"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-emberly-orange hover:text-emberly-orange-hover"
        >
          <Icon name="arrow-left" class="w-3.5 h-3.5" />
          <span>Back to all guides</span>
        </a>
      </footer>

      <!-- Bottom Assessment Promo Card -->
      <div class="mt-12 p-8 rounded-3xl bg-emberly-dark-charcoal text-white border border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div>
          <span class="text-xs uppercase font-bold tracking-wider text-emberly-orange">Free Practice Assessment</span>
          <h3 class="text-xl font-bold font-heading mt-1">Want us to audit your practice denial rate?</h3>
          <p class="text-xs sm:text-sm text-emberly-light-gray/80 mt-1 max-w-md">
            Our team will review your last 90 days of electronic remittances to identify recoverable revenue and coding gaps.
          </p>
        </div>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-emberly-orange text-white text-xs font-bold hover:bg-emberly-orange-hover shadow-card subtle-lift transition-all flex-shrink-0"
        >
          <span>Book an assessment</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
