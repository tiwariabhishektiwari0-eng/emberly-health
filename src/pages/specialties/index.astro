---
// src/pages/specialties/index.astro
// Specialties Hub Page showcasing 9 clinical specialties
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/common/Icon.astro';
import { getCollection } from 'astro:content';

const allSpecialties = await getCollection('specialties');
const sortedSpecialties = allSpecialties.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Medical Specialties & Clinical Billing Expertise | Emberly Health"
  description="Explore specialty-specific medical billing and certified coding for Primary Care, Cardiology, Orthopedics, Dermatology, Behavioral Health, Urgent Care, and Radiology."
>
  <!-- Hero Section -->
  <section class="py-14 sm:py-20 bg-white border-b border-emberly-light-gray">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emberly-orange-tint text-emberly-orange font-bold text-xs uppercase tracking-wider mb-4">
          <span>Clinical Depth</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-emberly-charcoal font-heading tracking-tight leading-tight">
          Specialty-Specific Revenue Cycle Expertise
        </h1>
        <p class="mt-4 text-base sm:text-lg text-emberly-mid-gray leading-relaxed">
          Generic billing approaches result in missed clinical revenue. Our coding pods master the specific modifiers, global surgery periods, and payer policies of your medical discipline.
        </p>
      </div>

      <!-- Quick Jump Specialty Navigation Pills -->
      <div class="mt-8 flex flex-wrap gap-2 pt-6 border-t border-emberly-light-gray/60">
        {sortedSpecialties.map((spec) => (
          <a
            href={`#specialty-${spec.slug}`}
            class="px-3.5 py-1.5 rounded-full bg-emberly-warm-white border border-emberly-light-gray text-xs font-semibold text-emberly-charcoal hover:border-emberly-orange hover:text-emberly-orange transition-colors"
          >
            {spec.data.shortName}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- One Section Per Specialty -->
  <div class="divide-y divide-emberly-light-gray">
    {sortedSpecialties.map((spec, idx) => (
      <section
        id={`specialty-${spec.slug}`}
        class={`py-16 sm:py-24 scroll-mt-24 ${idx % 2 === 0 ? 'bg-emberly-warm-white/50' : 'bg-white'}`}
      >
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-10">
            <!-- Left Info -->
            <div class="lg:w-1/2">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emberly-orange-tint text-emberly-orange font-bold text-xs uppercase tracking-wider mb-3">
                <Icon name={spec.data.icon} class="w-3.5 h-3.5" />
                <span>Specialty 0{spec.data.order}</span>
              </div>
              <h2 class="text-2xl sm:text-3xl font-extrabold text-emberly-charcoal font-heading tracking-tight mb-3">
                {spec.data.title}
              </h2>
              <p class="text-sm text-emberly-mid-gray leading-relaxed mb-6">
                {spec.data.summary}
              </p>

              <div class="p-4 rounded-2xl bg-white border border-emberly-light-gray mb-6">
                <span class="text-xs font-bold uppercase tracking-wider text-emberly-orange block mb-1">
                  Representative Benchmark*
                </span>
                <span class="text-sm font-semibold text-emberly-charcoal">
                  {spec.data.sampleBenchmark}
                </span>
              </div>

              <a
                href="/contact"
                class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-emberly-orange text-white text-xs font-bold hover:bg-emberly-orange-hover transition-colors subtle-lift"
              >
                <span>Audit your {spec.data.shortName} billing</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5" />
              </a>
            </div>

            <!-- Right Nuance & Denials Card -->
            <div class="lg:w-1/2 space-y-6">
              <!-- Coding Nuances -->
              <div class="bg-white border border-emberly-light-gray rounded-2xl p-6 shadow-subtle">
                <h3 class="text-xs font-bold uppercase tracking-wider text-emberly-charcoal flex items-center gap-1.5 mb-3">
                  <Icon name="file-check" class="w-4 h-4 text-emberly-orange" />
                  Clinical Coding Nuances Handled
                </h3>
                <ul class="space-y-2">
                  {spec.data.codingNuances.map((nuance) => (
                    <li class="flex items-start gap-2.5 text-xs text-emberly-charcoal">
                      <span class="w-1.5 h-1.5 rounded-full bg-emberly-orange mt-1.5 flex-shrink-0"></span>
                      <span>{nuance}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Denials Avoided -->
              <div class="bg-white border border-emberly-light-gray rounded-2xl p-6 shadow-subtle">
                <h3 class="text-xs font-bold uppercase tracking-wider text-emberly-charcoal flex items-center gap-1.5 mb-3">
                  <Icon name="shield-check" class="w-4 h-4 text-emberly-orange" />
                  Common Payer Denials Prevented
                </h3>
                <ul class="space-y-2">
                  {spec.data.commonDenialsAvoided.map((denial) => (
                    <li class="flex items-start gap-2.5 text-xs text-emberly-mid-gray">
                      <Icon name="check" class="w-3.5 h-3.5 text-emerald-600 flex-shrink-0 mt-0.5" />
                      <span>{denial}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))}
  </div>

  <!-- Bottom CTA -->
  <section class="py-16 sm:py-20 bg-emberly-dark-charcoal text-white text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl sm:text-3xl font-extrabold font-heading mb-3">
        Don't see your clinical specialty listed?
      </h2>
      <p class="text-xs sm:text-sm text-emberly-light-gray/80 max-w-xl mx-auto mb-8 leading-relaxed">
        Our certified coders handle pediatric subspecialties, pain management, ENT, gastroenterology, podiatry, and more. Reach out to discuss your specific clinical documentation.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-emberly-orange text-white font-bold text-sm hover:bg-emberly-orange-hover shadow-card subtle-lift transition-all"
      >
        <span>Discuss your specialty with our team</span>
        <Icon name="arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </section>
</BaseLayout>
